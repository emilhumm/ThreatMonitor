# ThreatMonitor settings. All optional.

# Only accept syslog from these senders (comma-separated): your OPNsense's LAN address, e.g. 192.168.1.1.
# Empty = anyone on the network may send.
TM_SYSLOG_ALLOW=

# The time zone the day's counts start again at midnight in (docker-compose.yml; default UTC).
TZ=UTC

# Where the arcs land. Leave empty to geolocate the WAN address seen in the firewall log.
TM_HOME_LAT=
TM_HOME_LON=
TM_HOME_LABEL=Home

# Push for health warnings (WAN address changed / IDS quiet): a Home Assistant webhook URL
# (http://<ha>:8123/api/webhook/<id>) or an ntfy topic URL (https://ntfy.sh/<topic>). Empty = banner only.
TM_NOTIFY_URL=
TM_IDS_SILENT_MIN=60
# The dashboard's address as your phone reaches it, for the link in a push (default http://localhost:5116/).
TM_DASHBOARD_URL=

# A DNS server for the container to ask first, e.g. your router (docker-compose.yml; public resolvers come after it).
TM_DNS=

# How many days of history to keep in data/history.db (a few MB a day).
TM_KEEP_DAYS=365

# Firewall rules by the id OPNsense logs (Firewall › Log Files › Live View, a line's ⓘ: rid): <rid>=<name>[:list],...
# ":list" marks a rule that blocks a threat list, so its knocks count as "on a threat list". Unset = only OPNsense's
# built-in default deny rule has a name. For example, with a rule that blocks a CrowdSec or Spamhaus list:
# TM_RULES=02f4bab031b57d1e30553ce08e0ec131=Default deny,<rid of your list rule>=Spamhaus DROP:list

# Nightly backup (install/install.sh backup) to an SMB share, e.g. a folder on the router's USB disk: the server's
# address, the share, and its login (written to /etc/smbcredentials/threatmonitor, readable by root only).
SMB_HOST=
SMB_SHARE=ThreatMonitor_Backup
SMB_USER=
SMB_PASSWORD=

# Ports: the dashboard (HTTP) and the syslog receiver (UDP and TCP).
TM_HTTP_PORT=5116
TM_SYSLOG_PORT=5514
